# Streamlit Cloud > Settings > Secrets içine yapıştır (yerelde .streamlit/secrets.toml).
# Gerçek değerleri GitHub'a ASLA commit etme.
ADMIN_PIN = "yönetici-pin"
APP_PASSWORD = "uygulama-giriş-şifresi"

[github]
db_sync = true                      # false/yok = yerel atlas_library.db (geliştirme)
token = "github_pat_..."            # fine-grained, sadece atlas-library, Contents: Read and write
repo = "Blixembosch/atlas-library"
branch = "data"
base = "main"
